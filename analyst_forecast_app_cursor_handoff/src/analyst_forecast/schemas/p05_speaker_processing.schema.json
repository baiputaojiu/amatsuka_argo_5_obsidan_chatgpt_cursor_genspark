{
  "$defs": {
    "P05PromptExecution": {
      "additionalProperties": false,
      "properties": {
        "prompt_id": {
          "const": "P05",
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Prompt Version",
          "type": "string"
        },
        "environment": {
          "enum": [
            "cursor",
            "chatgpt"
          ],
          "title": "Environment",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        }
      },
      "required": [
        "prompt_id",
        "prompt_version",
        "environment",
        "model",
        "executed_at"
      ],
      "title": "P05PromptExecution",
      "type": "object"
    },
    "SegmentOutput": {
      "additionalProperties": false,
      "properties": {
        "segment_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
          "title": "Segment Ref",
          "type": "string"
        },
        "sequence_number": {
          "minimum": 1,
          "title": "Sequence Number",
          "type": "integer"
        },
        "raw_start_offset": {
          "minimum": 0,
          "title": "Raw Start Offset",
          "type": "integer"
        },
        "raw_end_offset": {
          "exclusiveMinimum": 0,
          "title": "Raw End Offset",
          "type": "integer"
        },
        "raw_text": {
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        },
        "normalized_text": {
          "minLength": 1,
          "title": "Normalized Text",
          "type": "string"
        },
        "speaker_status": {
          "enum": [
            "identified",
            "unknown"
          ],
          "title": "Speaker Status",
          "type": "string"
        },
        "speaker_candidate": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker Candidate"
        },
        "speaker_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Speaker Confidence",
          "type": "number"
        },
        "attribution_basis": {
          "minLength": 1,
          "title": "Attribution Basis",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "accepted",
            "needs_review",
            "reviewed"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "importance": {
          "default": "normal",
          "enum": [
            "normal",
            "high"
          ],
          "title": "Importance",
          "type": "string"
        },
        "high_importance_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High Importance Reason"
        }
      },
      "required": [
        "segment_ref",
        "sequence_number",
        "raw_start_offset",
        "raw_end_offset",
        "raw_text",
        "normalized_text",
        "speaker_status",
        "speaker_confidence",
        "attribution_basis",
        "review_status"
      ],
      "title": "SegmentOutput",
      "type": "object"
    }
  },
  "$id": "https://local.invalid/schemas/p05-speaker-processing-2.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^RUN-\\d{8}-\\d{3}$",
      "title": "Run Id",
      "type": "string"
    },
    "source_id": {
      "pattern": "^SRC-\\d{6}$",
      "title": "Source Id",
      "type": "string"
    },
    "prompt_execution": {
      "$ref": "#/$defs/P05PromptExecution"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "knowledge_cutoff": {
      "format": "date-time",
      "title": "Knowledge Cutoff",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/SegmentOutput"
      },
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "source_id",
    "prompt_execution",
    "input_hash",
    "knowledge_cutoff",
    "segments"
  ],
  "title": "P05SpeakerProcessingOutput",
  "type": "object"
}
