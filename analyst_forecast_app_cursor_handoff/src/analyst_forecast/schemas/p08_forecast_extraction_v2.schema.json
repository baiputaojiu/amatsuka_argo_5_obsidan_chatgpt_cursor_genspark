{
  "$defs": {
    "Direction": {
      "enum": [
        "up",
        "down",
        "flat"
      ],
      "title": "Direction",
      "type": "string"
    },
    "EvidenceQuote": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^SRC-\\d{6}$",
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "exclusiveMinimum": 0,
          "title": "End Offset",
          "type": "integer"
        },
        "role": {
          "enum": [
            "prediction",
            "condition",
            "target",
            "timing",
            "magnitude",
            "context"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote",
        "start_offset",
        "end_offset",
        "role"
      ],
      "title": "EvidenceQuote",
      "type": "object"
    },
    "ForecastComponentV2": {
      "additionalProperties": false,
      "properties": {
        "component_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
          "title": "Component Ref",
          "type": "string"
        },
        "parent_component_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Component Ref"
        },
        "sequence_number": {
          "minimum": 1,
          "title": "Sequence Number",
          "type": "integer"
        },
        "prediction_form": {
          "enum": [
            "deadline_target",
            "point_in_time",
            "period_direction",
            "period_state",
            "turning_point",
            "relative",
            "range",
            "event"
          ],
          "title": "Prediction Form",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "time_expression_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Expression Raw"
        },
        "time_source": {
          "$ref": "#/$defs/TimeSource"
        },
        "normalized_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Start"
        },
        "normalized_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized End"
        },
        "time_precision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Precision"
        },
        "magnitude_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Magnitude Value"
        },
        "magnitude_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Magnitude Unit"
        },
        "magnitude_operator": {
          "anyOf": [
            {
              "enum": [
                "approximate",
                "minimum",
                "maximum",
                "range",
                "exact_target",
                "threshold"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Magnitude Operator"
        },
        "scenario_probability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Probability"
        },
        "raw_target_label": {
          "minLength": 1,
          "title": "Raw Target Label",
          "type": "string"
        },
        "target_resolution_status": {
          "const": "pending",
          "title": "Target Resolution Status",
          "type": "string"
        }
      },
      "required": [
        "component_ref",
        "sequence_number",
        "prediction_form",
        "direction",
        "time_source",
        "raw_target_label",
        "target_resolution_status"
      ],
      "title": "ForecastComponentV2",
      "type": "object"
    },
    "ForecastIssuanceV2": {
      "additionalProperties": false,
      "properties": {
        "forecast_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
          "title": "Forecast Ref",
          "type": "string"
        },
        "forecast_group_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
          "title": "Forecast Group Ref",
          "type": "string"
        },
        "existing_forecast_group_id": {
          "anyOf": [
            {
              "pattern": "^FCG-\\d{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Existing Forecast Group Id"
        },
        "made_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Made At"
        },
        "publicly_available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publicly Available At"
        },
        "made_at_source": {
          "default": "unknown",
          "enum": [
            "explicit",
            "source_metadata",
            "context_inferred",
            "unknown"
          ],
          "title": "Made At Source",
          "type": "string"
        },
        "forecast_type": {
          "enum": [
            "directional",
            "numeric",
            "conditional",
            "recommendation",
            "scenario"
          ],
          "title": "Forecast Type",
          "type": "string"
        },
        "commitment_strength": {
          "enum": [
            "explicit",
            "directional",
            "weak",
            "recommendation"
          ],
          "title": "Commitment Strength",
          "type": "string"
        },
        "evidence_level": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "extraction_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Extraction Confidence",
          "type": "number"
        },
        "importance": {
          "default": "normal",
          "enum": [
            "normal",
            "high"
          ],
          "title": "Importance",
          "type": "string"
        },
        "high_importance_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High Importance Reason"
        },
        "human_readable_summary": {
          "minLength": 1,
          "title": "Human Readable Summary",
          "type": "string"
        },
        "relation_to_previous": {
          "enum": [
            "initial",
            "reaffirmation",
            "strengthened",
            "weakened",
            "numeric_revision",
            "timing_revision",
            "condition_added",
            "reversal",
            "withdrawal"
          ],
          "title": "Relation To Previous",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceQuote"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ForecastComponentV2"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "upstream_segment_refs": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
            "type": "string"
          },
          "title": "Upstream Segment Refs",
          "type": "array"
        },
        "speaker_candidate": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker Candidate"
        },
        "speaker_attribution_status": {
          "default": "legacy_unknown",
          "enum": [
            "target_confirmed",
            "uncertain",
            "not_target",
            "legacy_unknown"
          ],
          "title": "Speaker Attribution Status",
          "type": "string"
        },
        "attribution_confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution Confidence"
        },
        "attribution_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution Basis"
        },
        "statement_kind": {
          "default": "legacy_unknown",
          "enum": [
            "direct_statement",
            "direct_quote",
            "third_party_summary",
            "legacy_unknown"
          ],
          "title": "Statement Kind",
          "type": "string"
        }
      },
      "required": [
        "forecast_ref",
        "forecast_group_ref",
        "forecast_type",
        "commitment_strength",
        "evidence_level",
        "extraction_confidence",
        "human_readable_summary",
        "relation_to_previous",
        "evidence",
        "components"
      ],
      "title": "ForecastIssuanceV2",
      "type": "object"
    },
    "P08PromptExecution": {
      "additionalProperties": false,
      "properties": {
        "prompt_id": {
          "const": "P08",
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Prompt Version",
          "type": "string"
        },
        "environment": {
          "enum": [
            "cursor",
            "chatgpt"
          ],
          "title": "Environment",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        }
      },
      "required": [
        "prompt_id",
        "prompt_version",
        "environment",
        "model",
        "executed_at"
      ],
      "title": "P08PromptExecution",
      "type": "object"
    },
    "TimeSource": {
      "enum": [
        "explicit",
        "inferred",
        "system_default",
        "none"
      ],
      "title": "TimeSource",
      "type": "string"
    }
  },
  "$id": "https://local.invalid/schemas/p08-forecast-extraction-2.1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "if": {
    "properties": {
      "schema_version": {
        "const": "2.1.0"
      }
    },
    "required": [
      "schema_version"
    ]
  },
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "enum": [
        "2.0.0",
        "2.1.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^RUN-\\d{8}-\\d{3}$",
      "title": "Run Id",
      "type": "string"
    },
    "source_id": {
      "pattern": "^SRC-\\d{6}$",
      "title": "Source Id",
      "type": "string"
    },
    "p05_artifact_id": {
      "anyOf": [
        {
          "pattern": "^AIF-\\d{6}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "P05 Artifact Id"
    },
    "upstream_artifact_id": {
      "anyOf": [
        {
          "pattern": "^AIF-\\d{6}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Upstream Artifact Id"
    },
    "upstream_prompt_id": {
      "anyOf": [
        {
          "enum": [
            "P05",
            "P07"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Upstream Prompt Id"
    },
    "prompt_execution": {
      "$ref": "#/$defs/P08PromptExecution"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "knowledge_cutoff": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Knowledge Cutoff"
    },
    "processing_status": {
      "enum": [
        "processed_with_forecasts",
        "processed_no_forecast"
      ],
      "title": "Processing Status",
      "type": "string"
    },
    "forecasts": {
      "items": {
        "$ref": "#/$defs/ForecastIssuanceV2"
      },
      "title": "Forecasts",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "source_id",
    "prompt_execution",
    "input_hash",
    "processing_status",
    "forecasts"
  ],
  "then": {
    "required": [
      "knowledge_cutoff"
    ]
  },
  "title": "P08ForecastExtractionOutput",
  "type": "object"
}
