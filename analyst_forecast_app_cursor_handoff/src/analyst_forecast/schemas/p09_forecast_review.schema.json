{
  "$defs": {
    "ForecastCorrectionOperation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": ["update", "add", "remove"],
          "title": "Action",
          "type": "string"
        },
        "reviewed_forecast_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed Forecast Ref"
        },
        "corrected_forecast_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corrected Forecast Ref"
        },
        "reason": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": ["action", "reason"],
      "title": "ForecastCorrectionOperation",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": { "action": { "const": "update" } },
            "required": ["action"]
          },
          "then": {
            "required": ["reviewed_forecast_ref", "corrected_forecast_ref"],
            "properties": {
              "reviewed_forecast_ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
              },
              "corrected_forecast_ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "action": { "const": "add" } },
            "required": ["action"]
          },
          "then": {
            "required": ["corrected_forecast_ref"],
            "properties": {
              "reviewed_forecast_ref": { "type": "null" },
              "corrected_forecast_ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "action": { "const": "remove" } },
            "required": ["action"]
          },
          "then": {
            "required": ["reviewed_forecast_ref"],
            "properties": {
              "reviewed_forecast_ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
              },
              "corrected_forecast_ref": { "type": "null" }
            }
          }
        }
      ]
    },
    "P09PromptExecution": {
      "additionalProperties": false,
      "properties": {
        "prompt_id": {
          "const": "P09",
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Prompt Version",
          "type": "string"
        },
        "environment": {
          "enum": ["cursor", "chatgpt"],
          "title": "Environment",
          "type": "string"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        }
      },
      "required": [
        "prompt_id",
        "prompt_version",
        "environment",
        "model",
        "executed_at"
      ],
      "title": "P09PromptExecution",
      "type": "object"
    },
    "ReviewFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
          "title": "Finding Ref",
          "type": "string"
        },
        "severity": {
          "enum": ["info", "warning", "error"],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": ["finding_ref", "severity", "message", "evidence"],
      "title": "ReviewFinding",
      "type": "object"
    }
  },
  "$id": "https://local.invalid/schemas/p09-forecast-review-2.1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "予想抽出レビュー。集合完全被覆（O/N set equality）は application validator の責務。",
  "properties": {
    "schema_version": {
      "default": "2.1.0",
      "enum": ["2.0.0", "2.1.0"],
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "pattern": "^RUN-\\d{8}-\\d{3}$",
      "title": "Run Id",
      "type": "string"
    },
    "source_id": {
      "pattern": "^SRC-\\d{6}$",
      "title": "Source Id",
      "type": "string"
    },
    "reviewed_artifact_id": {
      "pattern": "^AIF-\\d{6}$",
      "title": "Reviewed Artifact Id",
      "type": "string"
    },
    "prompt_execution": {
      "$ref": "#/$defs/P09PromptExecution"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "decision": {
      "enum": ["accept", "correct", "reject", "unresolved"],
      "title": "Decision",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ReviewFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "corrected_payload": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corrected Payload"
    },
    "forecast_operations": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ForecastCorrectionOperation"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Forecast Operations"
    },
    "knowledge_cutoff": {
      "format": "date-time",
      "title": "Knowledge Cutoff",
      "type": "string"
    },
    "reject_disposition": {
      "anyOf": [
        {
          "enum": ["retryable", "terminal"],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reject Disposition"
    },
    "reject_reason": {
      "anyOf": [
        {
          "type": "string",
          "pattern": ".*\\S.*"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reject Reason"
    },
    "reject_terminal": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reject Terminal"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "source_id",
    "reviewed_artifact_id",
    "prompt_execution",
    "input_hash",
    "decision",
    "knowledge_cutoff"
  ],
  "title": "P09ForecastExtractionReviewOutput",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": { "const": "2.1.0" },
          "decision": { "const": "reject" }
        },
        "required": ["schema_version", "decision"]
      },
      "then": {
        "required": ["reject_disposition", "reject_reason"],
        "properties": {
          "reject_disposition": {
            "type": "string",
            "enum": ["retryable", "terminal"]
          },
          "reject_reason": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "reject_terminal": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": { "const": "2.1.0" },
          "decision": { "enum": ["accept", "correct", "unresolved"] }
        },
        "required": ["schema_version", "decision"]
      },
      "then": {
        "properties": {
          "reject_disposition": { "type": "null" },
          "reject_reason": { "type": "null" },
          "reject_terminal": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": { "const": "2.0.0" },
          "decision": { "const": "reject" }
        },
        "required": ["schema_version", "decision"]
      },
      "then": {
        "required": ["reject_terminal", "reject_reason"],
        "properties": {
          "reject_terminal": { "type": "boolean" },
          "reject_reason": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "reject_disposition": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": { "const": "2.0.0" },
          "decision": { "enum": ["accept", "correct", "unresolved"] }
        },
        "required": ["schema_version", "decision"]
      },
      "then": {
        "properties": {
          "reject_disposition": { "type": "null" },
          "reject_reason": { "type": "null" },
          "reject_terminal": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "decision": { "const": "correct" } },
        "required": ["decision"]
      },
      "then": {
        "required": ["corrected_payload"],
        "properties": {
          "corrected_payload": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": { "enum": ["accept", "reject", "unresolved"] }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "corrected_payload": { "type": "null" },
          "forecast_operations": { "type": "null" }
        }
      }
    }
  ]
}
